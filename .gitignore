# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper raw output (large, regenerable via `tsx scripts/extract/run.ts all` + normalize.ts;
# only /data/clean is read by the app at runtime)
/data/raw/

# local background-task log files
*.log

# local-dev-only runtime state (orders placed / catalog overrides while testing) — the
# committed seed is data/runtime/project-jobs.json only; on Vercel this data lives in Redis
# instead (see lib/kv.ts), never in these files
/data/runtime/orders.json
/data/runtime/catalog-overrides.json

