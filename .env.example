# Copy to .env.local for local overrides. None of these are required to run `pnpm dev` —
# the app falls back to local JSON files for orders/project-jobs/catalog-overrides and to
# localhost URLs for sitemap/JSON-LD when they're unset.

# Set this once you know your real production domain (or your Vercel URL). Used for
# sitemap.xml, robots.txt and JSON-LD absolute links. Falls back to Vercel's own
# auto-injected URL, then localhost, if left unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Required only on Vercel (its serverless functions can't write to the filesystem — see
# README "Known gaps"). Connect a Redis store via Vercel Marketplace (Storage tab -> Create
# Database -> Redis -> Connect to Project) and it injects this automatically; you shouldn't
# need to set it by hand.
# REDIS_URL=

# Switches brand resolution from route-prefix (/s/[brand]) to subdomain-based. Off by
# default so the demo works on one URL; see middleware.ts.
# NEXT_PUBLIC_BRAND_BY_HOSTNAME=false
